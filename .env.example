# Optional. Docker Compose uses 8080 when this file does not exist.
PORT=8080

# Advanced options. SESSION_SECRET may remain empty: the application generates
# it once and stores it in the persistent data volume.
SESSION_HOURS=168
COOKIE_SECURE=false
X_ACCOUNT_ID=
SESSION_SECRET=
EMBEDDING_THREADS=2
EMBEDDING_MIN_AVAILABLE_MIB=1536
EMBEDDING_RLIMIT_AS_MIB=1536
